# Key names only. Values go in /workspace/referral-connection/.secrets/site.env by hidden prompt, never in a chat.
# Written by install.py (not secrets):
BOT_HOME=/workspace/referral-connection
CONVLOG_TZ=America/New_York
RC_SITE=https://findreferralpartners.com
# The referral site's admin API: the ADMIN_KEY variable on the site's service
RC_ADMIN_KEY=
# Claude Code CLI, only if the bot's computer is not signed in already: the token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
